{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "typeRoots": ["./node_modules/@types", "src/shared/types"],
    "sourceMap": true,
  },
  "include": ["src/**/*", "src/modules/auth/prisma.config.ts"],
  "exclude": ["node_modules"],
}