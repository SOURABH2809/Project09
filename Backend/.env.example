
# ==================================================
# APPLICATION CONFIGURATION
# ==================================================
NODE_ENV=development
PORT=5001
BASE_URL=http://localhost:5001
FRONTEND_URL=http://localhost:3000


# ==================================================
# DATABASE CONFIGURATION
# ==================================================
POSTGRES_USER=your-postgres-user
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=your-database-name
DB_PORT=5433

# OPTION 1: Backend + PostgreSQL running locally
# DATABASE_URL=postgresql://your-user:your-password@localhost:5432/your-database

# OPTION 2: Backend local + PostgreSQL in Docker
# DATABASE_URL=postgresql://your-user:your-password@localhost:5433/your-database

# OPTION 3: Backend + PostgreSQL both running in Docker
DATABASE_URL=postgresql://your-user:your-password@db:5432/your-database

# OPTION 4: Backend in Docker + PostgreSQL running on host
# DATABASE_URL=postgresql://your-user:your-password@host.docker.internal:5432/your-database


# ==================================================
# AUTHENTICATION & TOKENS
# ==================================================
ACCESS_TOKEN_SECRET=replace-with-a-strong-access-token-secret
REFRESH_TOKEN_SECRET=replace-with-a-strong-refresh-token-secret

# Bootstrap administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password


# ==================================================
# GOOGLE OAUTH CONFIGURATION
# ==================================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5001/api/v1/auth/oauth/google/callback
GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token


# ==================================================
# FRONTEND AUTHENTICATION PAGES
# ==================================================
FE_RESET_PASSWORD_PAGE_URL=http://localhost:3000/reset-password
FE_2FA_VERIFICATION_URL=http://localhost:3000/2fa-verification


# ==================================================
# TWO-FACTOR AUTHENTICATION (2FA)
# ==================================================
DEVICE_TOKEN_COOKIE_KEY=deviceToken

# Device trust duration: 30 days (milliseconds)
DEVICE_TRUST_DURATION_MS=2592000000

# Email verification token expiry: 10 minutes (milliseconds)
TWO_FACTOR_EMAIL_TOKEN_EXPIRY_MS=600000

# Number of backup codes to generate
BACKUP_CODES_COUNT=10


# ==================================================
# RABBITMQ CONFIGURATION
# ==================================================

# OPTION 1: RabbitMQ running locally
# RABBITMQ_URL=amqp://your-user:your-password@127.0.0.1:5672/

# OPTION 2: RabbitMQ running in Docker Compose
RABBITMQ_URL=amqp://your-user:your-password@rabbitmq:5672

RABBITMQ_USER=your-rabbitmq-user
RABBITMQ_PASS=your-rabbitmq-password
RABBITMQ_PORT=5672


# ==================================================
# REDIS CONFIGURATION
# ==================================================

# OPTION 1: Redis running locally
# REDIS_HOST=localhost

# OPTION 2: Redis running in Docker Compose
REDIS_HOST=redis

REDIS_PORT=6379

# Session TTL: 24 hours (seconds)
SESSION_TTL=86400

# User permission cache TTL: 24 hours (seconds)
USER_PERMISSION_CACHE_TTL=86400
