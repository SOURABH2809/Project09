generator client {
  provider = "prisma-client"
  output   = "../database/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["notification"]
}

model InAppNotification {
  id          String   @id @default(uuid())
  userId      String   @db.Uuid

  title       String
  message     String
  link        String?

  type        InAppNotificationType @default(GENERAL)
  severity    InAppNotificationSeverity @default(INFO)
  read        Boolean  @default(false)

  deletedAt   DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("in_app_notifications")
  @@schema("notification")
}

enum InAppNotificationType {
  GENERAL
  SYSTEM
  ACCOUNT
  BILLING
  TRANSACTION
  SECURITY
  PERMISSION
  REMINDER
  ANNOUNCEMENT

  @@schema("notification")
}

enum InAppNotificationSeverity {
  INFO
  SUCCESS
  WARNING
  ERROR
  CRITICAL

  @@schema("notification")
}