  "type": "module",
  "lint-staged": {
    "**/*.ts": [
      "eslint . --ext .ts --config ./config/eslint.config.js",
      "prettier --check . --config ./config/prettier.config.json"
    ]
  },
  "scripts": {
    "lint": "eslint . --ext .ts --config ./config/eslint.config.js",
    "lint:fix": "eslint . --ext .ts --config ./config/eslint.config.js --fix",
    "format": "prettier --check . --config ./config/prettier.config.json",
    "format:fix": "prettier --write . --config ./config/prettier.config.json",
    "prepare": "husky",
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "seed:admin": "tsx src/modules/auth/prisma/seed.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "create:module": "node ./generators/create-module.ts"
  },
